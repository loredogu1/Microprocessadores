# SEL0337 - Pratica 5
# Arquivo modelo para /etc/systemd/system/blink.service
# O instalador configura automaticamente User e os caminhos reais do projeto.
[Unit]
Description=SEL0337 - Controle de brilho de LED por PWM
After=local-fs.target

[Service]
Type=simple
User=sel
WorkingDirectory=/home/sel/6190
ExecStart=/usr/bin/python3 /home/sel/6190/LED_PWM.py
ExecStop=/usr/bin/python3 /home/sel/6190/parar_led.py $MAINPID
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
